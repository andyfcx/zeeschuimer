{
  "description": "Collect data while browsing social media platforms and upload it for analysis later",
  "manifest_version": 3,
  "name": "Zeeschuimer",
  "version": "1.13.1",
  "homepage_url": "https://github.com/digitalmethodsinitiative/zeeschuimer",

  "icons": {
    "48": "images/zeeschuimer-48.png",
    "96": "images/zeeschuimer-96.png"
  },

  "action": {
    "default_icon": "images/zeeschuimer-64.png",
    "default_title": "Zeeschuimer Status"
  },

  "permissions": [
    "webNavigation", "storage", "downloads", "activeTab", "tabs", "unlimitedStorage"
  ],

  "host_permissions": ["https://*/*"],

  "background": {
    "service_worker": "js/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["js/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*"],
      "js": ["js/content-script.js"],
      "run_at": "document_start"
    }
  ]
}

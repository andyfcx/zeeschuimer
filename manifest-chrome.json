{
  "description": "Collect data while browsing social media platforms and upload it for analysis later",
  "manifest_version": 3,
  "name": "Zeeschuimer",
  "version": "1.13.1",
  "homepage_url": "https://github.com/digitalmethodsinitiative/zeeschuimer",
  "minimum_chrome_version": "111",
  "icons": {
    "48": "images/zeeschuimer-48.png",
    "96": "images/zeeschuimer-96.png"
  },
  "action": {
    "default_icon": "images/zeeschuimer-64.png",
    "default_title": "Zeeschuimer Status"
  },
  "permissions": [
    "webNavigation",
    "storage",
    "downloads",
    "activeTab",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://threads.com/*",
    "https://*.threads.com/*",
    "https://threads.net/*",
    "https://*.threads.net/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://9gag.com/*",
    "https://*.9gag.com/*",
    "https://imgur.com/*",
    "https://*.imgur.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://douyin.com/*",
    "https://*.douyin.com/*",
    "https://gab.com/*",
    "https://*.gab.com/*",
    "https://truthsocial.com/*",
    "https://*.truthsocial.com/*",
    "https://pinterest.com/*",
    "https://*.pinterest.com/*",
    "https://xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "js/zs-service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://9gag.com/*",
        "https://*.9gag.com/*",
        "https://imgur.com/*",
        "https://*.imgur.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://douyin.com/*",
        "https://*.douyin.com/*",
        "https://gab.com/*",
        "https://*.gab.com/*",
        "https://truthsocial.com/*",
        "https://*.truthsocial.com/*",
        "https://pinterest.com/*",
        "https://*.pinterest.com/*",
        "https://xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ],
      "js": [
        "js/zs-capture-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://9gag.com/*",
        "https://*.9gag.com/*",
        "https://imgur.com/*",
        "https://*.imgur.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://douyin.com/*",
        "https://*.douyin.com/*",
        "https://gab.com/*",
        "https://*.gab.com/*",
        "https://truthsocial.com/*",
        "https://*.truthsocial.com/*",
        "https://pinterest.com/*",
        "https://*.pinterest.com/*",
        "https://xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ],
      "js": [
        "js/zs-capture-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
